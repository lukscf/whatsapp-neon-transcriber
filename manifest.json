{
  "manifest_version": 3,
  "name": "WhatsApp Neon Transcriber",
  "version": "2.1.0",
  "description": "Transcreve automaticamente os áudios do WhatsApp Web com o Whisper local gratuito e aplica um tema dark roxo neon.",
  "permissions": ["storage", "unlimitedStorage", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["https://web.whatsapp.com/*"] }
  ],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "WhatsApp Neon Transcriber", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js", "fx.js"],
      "css": ["theme.css", "fx.css"],
      "run_at": "document_start"
    }
  ]
}
